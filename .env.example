# Copy to .env for local development (never commit real secrets)
NAIRABOOKS_ENV=development
NAIRABOOKS_DEFAULT_CURRENCY=NGN
NAIRABOOKS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nairabooks
NAIRABOOKS_SECRET_KEY=replace-with-local-dev-secret-before-running

# Web app (Next.js) auth — required in production (min 32 chars), e.g. `openssl rand -hex 32`
NAIRABOOKS_SESSION_SECRET=
# Optional: enables the 5 demo accounts in production with this password (unset = no demo accounts).
# Outside production the built-in demo password is used when this is empty.
NAIRABOOKS_DEMO_PASSWORD=
# Web app storage: Postgres connection string (Neon in production). Empty = files in web/.data/documents.
DATABASE_URL=
