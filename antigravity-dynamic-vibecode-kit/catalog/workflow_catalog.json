      "title": "Phase 1: Idea, Market & Business Validation",
      "plainGoal": "Check user demand, competitors, and business viability before writing specs.",
      "mode": "once",
      "docs": [
        "docs/PRD.md",
        "docs/DECISIONS.md",
        "docs/STAGE_LOG.md"
      ]
    },
    {
      "stageOrder": 2,
      "stageId": "phase-2-foundation",
      "title": "Phase 2: Project Spec, Context Memory & Starter Files",
      "plainGoal": "Lock what the product does, set up Conductor tracking, and create the starter folder.",
      "mode": "once",
      "docs": [
        "docs/PRD.md",
        "docs/STATE.md",
        "docs/SESSION_HANDOFF.md",
        "docs/STAGE_LOG.md"
      ]
    },
    {
      "stageOrder": 3,
      "stageId": "phase-3-architecture",
      "title": "Phase 3: System Architecture, APIs & Safety Design",
      "plainGoal": "Plan how screens, server endpoints, and safety checks fit together.",
      "mode": "once",
      "docs": [
        "docs/ARCHITECTURE.md",
        "docs/DECISIONS.md",
        "docs/STAGE_LOG.md"
      ]
    },
    {
      "stageOrder": 4,
      "stageId": "phase-4-database",
      "title": "Phase 4: Database & Data Persistence",
      "plainGoal": "Design how data is saved cleanly and updated without losing user records.",
      "mode": "once",
      "docs": [
        "docs/ARCHITECTURE.md",
        "docs/DECISIONS.md",
        "docs/STAGE_LOG.md"
      ]
    },
    {
      "stageOrder": 5,
      "stageId": "phase-5-design",
      "title": "Phase 5: Visual Design System & Accessibility",
      "plainGoal": "Choose layout, colors, fonts, and keyboard/screen-reader accessibility first.",
      "mode": "once",
      "docs": [
        "docs/ARCHITECTURE.md",
        "docs/DECISIONS.md",
        "docs/USER_GUIDE.md",
        "docs/STAGE_LOG.md"
      ]
    },
    {
      "stageOrder": 6,
      "stageId": "phase-6-core-build",
      "title": "Phase 6: Core Build Loop (Tests + Language Stack)",
      "plainGoal": "Build your core app features slice-by-slice with test safety nets.",
      "mode": "per_slice",
      "docs": [
        "docs/STATE.md",
        "docs/STAGE_LOG.md",
        "docs/USER_GUIDE.md"
      ]
    },
    {
      "stageOrder": 7,
      "stageId": "phase-7-modules",
      "title": "Phase 7: Product Features (Auth, Billing, AI, Specialty)",
      "plainGoal": "Wire login, payments, AI/OCR, or specialized engines into working slices.",
      "mode": "per_slice",
      "docs": [
        "docs/PRD.md",
        "docs/ARCHITECTURE.md",
        "docs/STAGE_LOG.md",
        "docs/USER_GUIDE.md"
      ]
    },
    {
      "stageOrder": 8,
      "stageId": "phase-8-verification",
      "title": "Phase 8: Testing, Bug Fixing & Code Quality Gate",
      "plainGoal": "Verify features end-to-end, squash failures (if red), and clean code (when green).",
      "mode": "per_slice",
      "docs": [
        "docs/STAGE_LOG.md",
        "docs/SKILL_COVERAGE.md",
        "docs/STATE.md"
      ]
    },
    {
      "stageOrder": 9,
      "stageId": "phase-9-security",
      "title": "Phase 9: Security Audit, Package Safety & Privacy Rules",
      "plainGoal": "Scan code/dependencies for vulnerabilities and check legal/GDPR rules.",
      "mode": "pre_launch",
      "docs": [
        "docs/DECISIONS.md",
        "docs/STAGE_LOG.md",
        "docs/SKILL_COVERAGE.md"
      ]
    },
    {
      "stageOrder": 10,
      "stageId": "phase-10-deploy",
      "title": "Phase 10: Git Workflow, CI/CD & Cloud Deployment",
      "plainGoal": "Set up version control, automated checks, and deploy your app online.",
      "mode": "pre_launch",
      "docs": [
        "docs/ARCHITECTURE.md",
        "docs/STAGE_LOG.md",
        "docs/SESSION_HANDOFF.md"
      ]
    },
    {
      "stageOrder": 11,
      "stageId": "phase-11-ops",
      "title": "Phase 11: Live Monitoring, Alerts & Crash Recovery",
      "plainGoal": "Add uptime charts, error alerts, and playbooks for live production issues.",
      "mode": "pre_launch",
      "docs": [
        "docs/USER_GUIDE.md",
        "docs/STAGE_LOG.md",
        "docs/STATE.md"
      ]
    },
    {
      "stageOrder": 12,
      "stageId": "phase-12-launch",
      "title": "Phase 12: User Docs, Launch Copy & SEO Growth",
      "plainGoal": "Write clear guides, landing page messaging, and search-friendly content.",
      "mode": "pre_launch",
      "docs": [
        "docs/USER_GUIDE.md",
        "docs/STAGE_LOG.md",
        "docs/SKILL_COVERAGE.md"
      ]
    }
